{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "enabled": false,
      "description": "Major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Major updates"
    },
    {
      "description": "Minor and patch updates ",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Minor and patch updates"
    }
  ]
}
